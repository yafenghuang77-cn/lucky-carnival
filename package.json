{
  "name": "lucky-carnival",
  "version": "1.0.0",
  "private": true,
  "description": "幸运嘉年华",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Less",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "lint:style": "stylelint \"src/**/*.{css,less}\" --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm lint:style && pnpm typecheck",
    "check:staged": "lint-staged",
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:swan": "taro build --type swan",
    "dev:swan": "npm run build:swan -- --watch",
    "build:alipay": "taro build --type alipay",
    "dev:alipay": "npm run build:alipay -- --watch",
    "build:tt": "taro build --type tt",
    "dev:tt": "npm run build:tt -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "build:rn": "taro build --type rn",
    "dev:rn": "npm run build:rn -- --watch",
    "build:qq": "taro build --type qq",
    "dev:qq": "npm run build:qq -- --watch",
    "build:jd": "taro build --type jd",
    "dev:jd": "npm run build:jd -- --watch",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch"
  },
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.1",
    "@tarojs/helper": "4.3.1",
    "@tarojs/plugin-framework-react": "4.3.1",
    "@tarojs/plugin-platform-alipay": "4.3.1",
    "@tarojs/plugin-platform-h5": "4.3.1",
    "@tarojs/plugin-platform-harmony-hybrid": "4.3.1",
    "@tarojs/plugin-platform-jd": "4.3.1",
    "@tarojs/plugin-platform-qq": "4.3.1",
    "@tarojs/plugin-platform-swan": "4.3.1",
    "@tarojs/plugin-platform-tt": "4.3.1",
    "@tarojs/plugin-platform-weapp": "4.3.1",
    "@tarojs/react": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "dayjs": "^1.11.23",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.3.1",
    "@tarojs/plugin-generator": "4.3.1",
    "@tarojs/taro-loader": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/minimatch": "^5",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "babel-preset-taro": "4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-taro": "4.3.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.10",
    "react-refresh": "^0.14.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  }
}
