{
  "root": true,
  "env": {
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "lib/",
    "coverage/",
    "deploy_versions/",
    ".temp/",
    ".rn_temp/",
    ".swc/",
    ".mimocode/"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react/jsx-runtime",
    "plugin:react-hooks/recommended",
    "plugin:jsx-a11y/recommended",
    "plugin:import/recommended",
    "taro/rules/jsx",
    "taro/rules/imports",
    "taro/rules/variables",
    "prettier"
  ],
  "plugins": ["react", "react-hooks", "import", "simple-import-sort"],
  "settings": {
    "react": {
      "version": "detect"
    },
    "jsx-a11y": {
      "components": {
        "View": "div",
        "Text": "span",
        "Button": "button",
        "ActionButton": "button",
        "Input": "input",
        "Textarea": "textarea",
        "Image": "img",
        "Label": "label",
        "Video": "video"
      }
    },
    "import/internal-regex": "^@/",
    "import/core-modules": null,
    "import/parsers": {
      "@typescript-eslint/parser": [".ts", ".tsx"]
    },
    "import/resolver": {
      "typescript": {
        "project": "./tsconfig.json"
      },
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx", ".cjs", ".mjs", ".json"]
      }
    }
  },
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "curly": ["error", "all"],
    "array-callback-return": "error",
    "no-var": "error",
    "prefer-const": "error",
    "object-shorthand": ["error", "always"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-debugger": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-param-reassign": [
      "error",
      {
        "props": false
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": [
      "error",
      {
        "checkFragmentShorthand": true
      }
    ],
    "react/jsx-no-useless-fragment": "error",
    "react/no-array-index-key": "error",
    "react/no-unstable-nested-components": "error",
    "react/button-has-type": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "import/no-unresolved": [
      "error",
      {
        "ignore": ["\\.(css|less|scss|sass|styl)$"]
      }
    ],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-cycle": [
      "error",
      {
        "ignoreExternal": true,
        "maxDepth": 3
      }
    ],
    "import/named": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/first": ["error", "disable-absolute-first"],
    "import/newline-after-import": "error",
    "import/order": "off",
    "sort-imports": "off",
    "simple-import-sort/imports": [
      "error",
      {
        "groups": [["^node:"], ["^@?\\w"], ["^@/"], ["^\\."], ["^.*\\u0000$"], ["^\\u0000"]]
      }
    ],
    "simple-import-sort/exports": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{js,jsx,ts,tsx}"],
      "env": {
        "browser": true
      },
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "JSXOpeningElement[name.type='JSXIdentifier'][name.name=/^[a-z]/]",
            "message": "页面和组件必须使用 Taro 组件，不要使用原生 HTML 标签。"
          }
        ],
        "import/no-nodejs-modules": "error",
        "import/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": false
          }
        ]
      }
    },
    {
      "files": ["**/*.{ts,tsx}"],
      "parser": "@typescript-eslint/parser",
      "extends": ["plugin:@typescript-eslint/recommended", "plugin:import/typescript"],
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "off",
        "no-shadow": "off",
        "no-use-before-define": "off",
        "react/prop-types": "off",
        "@typescript-eslint/no-explicit-any": "error",
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "fixStyle": "separate-type-imports"
          }
        ],
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_",
            "ignoreRestSiblings": true
          }
        ],
        "@typescript-eslint/no-shadow": "error",
        "@typescript-eslint/no-use-before-define": [
          "error",
          {
            "functions": false,
            "classes": false,
            "variables": false,
            "typedefs": false
          }
        ]
      }
    },
    {
      "files": ["babel.config.js", "config/**/*.{js,cjs,mjs,ts}"],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-commonjs": "off",
        "import/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": true
          }
        ]
      }
    },
    {
      "files": [
        "**/*.{test,spec}.{js,jsx,ts,tsx,cjs,mjs}",
        "**/__tests__/**/*.{js,jsx,ts,tsx,cjs,mjs}"
      ],
      "extends": ["plugin:jest/recommended"],
      "env": {
        "node": true
      },
      "rules": {
        "jest/no-deprecated-functions": "off",
        "import/no-nodejs-modules": "off",
        "import/no-extraneous-dependencies": ["error", { "devDependencies": true }]
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "@typescript-eslint/no-namespace": "off",
        "@typescript-eslint/triple-slash-reference": "off",
        "import/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": true
          }
        ]
      }
    }
  ]
}
