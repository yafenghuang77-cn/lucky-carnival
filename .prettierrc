{
  "plugins": ["prettier-plugin-packagejson"],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": [".eslintrc", ".prettierrc", ".stylelintrc", ".commitlintrc", ".lintstagedrc"],
      "options": {
        "parser": "json"
      }
    }
  ]
}
